<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      App theme. Key point: windowBackground is PURE BLACK.

      The launcher previously used @android:style/Theme.Material.NoActionBar, whose
      windowBackground is Material dark-grey (#303030). Whenever the window exists but
      Compose hasn't drawn its first frame yet — Activity relaunch, a config-change race,
      or a cold start on this HCT/Microntek head unit — that grey window background shows
      through as the recurring "серый экран". Painting the window black makes any such
      blank frame invisible against our black UI instead of flashing grey.
    -->
    <style name="Theme.BmwLauncher" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
</resources>
